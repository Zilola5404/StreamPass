# Copy to .env and fill in real values. Never commit the real .env file.

DB_HOST=postgres
DB_NAME=streampass
DB_USER=streampass
DB_PASSWORD=change-me

REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# 32+ random bytes, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret for Admin UI /admin/ and operator API (X-Admin-Key).
ADMIN_API_KEY=change-me-to-a-long-random-string

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://your-domain.example/payment/return

# Telegram Stars payments (TZ 02.3). Prefer these over live YooKassa for MVP.
TELEGRAM_BOT_TOKEN=
# Optional secret for X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
STREAMPASS_PUBLIC_URL=https://212-43-156-33.nip.io
# USDT TRC20 deposit address shown on /pay/
USDT_TRC20_ADDRESS=

# Optional monitoring (BL-021) — Grafana binds to 127.0.0.1:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://127.0.0.1:3000
