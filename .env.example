# Copy to .env and fill in real values. Never commit the real .env file.

DB_HOST=postgres
DB_NAME=streampass
DB_USER=streampass
DB_PASSWORD=change-me

REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# 32+ random bytes, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret required in the X-Admin-Key header for operator-only
# endpoints (POST /rules, POST /config, POST /servers/health) until a
# full Admin Panel with real operator accounts exists.
ADMIN_API_KEY=change-me-to-a-long-random-string

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://your-domain.example/payment/return
