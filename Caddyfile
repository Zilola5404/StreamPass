212-43-156-33.nip.io {
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	redir /admin /admin/

	# Public artifacts only (APK, rule-sets). No relay passwords here.
	# Directory listing disabled (was: file_server browse).
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	# Public payment page (Telegram Stars / USDT) — TZ 02.3
	handle_path /pay/* {
		root * /srv/web
		rewrite * /pay.html
		file_server
	}
	redir /pay /pay/

	# Metrics stay on the Docker network (Prometheus → backend:8080), not public.
	handle /metrics {
		respond 404
	}
	handle /api/v1/metrics {
		respond 404
	}

	handle {
		reverse_proxy backend:8080
	}
}
