212-43-156-33.nip.io {
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	redir /admin /admin/

	handle_path /downloads/* {
		root * /srv/downloads
		file_server browse
	}

	# Metrics stay on the Docker network (Prometheus → backend:8080), not public.
	handle /metrics {
		respond 404
	}
	handle /api/v1/metrics {
		respond 404
	}

	handle {
		reverse_proxy backend:8080
	}
}
